# Copy to ~/.secrets-config — maps env var names to Dashlane item paths.
# Consumed by refresh-secrets, which regenerates ~/.secrets from this file.
# This file holds vault paths only, never secret values, so it is safe to track.
#
# Format:
#   KEY=dl://<item-title>/<field>   field is "password" for password items,
#                                   "note" for secure notes (use for long
#                                   values like JWTs)
#   KEY=$OTHER_KEY                  alias: mirrors another var, no vault lookup.
#                                   Must be listed AFTER the var it references.
#
# IMPORTANT: refresh-secrets overwrites ~/.secrets wholesale. Any var missing
# from this file is destroyed on the next run — list every var you need.
#
# Never export credentials from stow/zsh/.zshrc directly: ~/.zshrc is a stow
# symlink into this repo, so anything set there becomes tracked content.
#
# Run `dcli secret -o json` to inspect item titles and available fields.
# Run `refresh-secrets` after updating this file.

GITHUB_PERSONAL_ACCESS_TOKEN=dl://github-personal-access-token/password

ARTIFACTORY_IDENTITY_TOKEN=dl://artifactory-identity-token/password
JFROG_ACCESS_TOKEN=dl://jfrog-access-token/note
# Terraform reads this as var.artifactory_access_token; mirrors the token above
TF_VAR_artifactory_access_token=$JFROG_ACCESS_TOKEN

ANTHROPIC_ANALYTICS_KEY=dl://anthropic-analytics-key/password
ANTHROPIC_ADMIN_KEY_SONATUS=dl://anthropic-admin-key-sonatus/password
ANTHROPIC_ADMIN_KEY_OCTO=dl://anthropic-admin-key-octo/password
