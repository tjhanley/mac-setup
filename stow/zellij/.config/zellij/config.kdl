// Zellij configuration
// Uses Zellij's builtin catppuccin-mocha theme.

theme "catppuccin-mocha";

// UI preferences
simplified_ui true;
pane_frames true;
scrollback_editor "nvim";
mouse_mode true;
session_serialization true;

keybinds {
    shared_except "locked" {
        unbind "Ctrl q"
        // Seamless Ctrl+h/j/k/l navigation between Neovim splits and Zellij panes.
        // In Neovim panes, zellij-autolock locks the session so these keys reach
        // Neovim (zellij-nav.nvim crosses the edge back into Zellij). Elsewhere
        // vim-zellij-navigator moves Zellij focus (and tabs on left/right).
        bind "Ctrl h" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab"; payload "left"; move_mod "ctrl";
            }
        }
        bind "Ctrl j" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus"; payload "down"; move_mod "ctrl";
            }
        }
        bind "Ctrl k" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus"; payload "up"; move_mod "ctrl";
            }
        }
        bind "Ctrl l" {
            MessagePlugin "file:~/.config/zellij/plugins/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab"; payload "right"; move_mod "ctrl";
            }
        }
    }
    shared {
        bind "Super k" { Clear; Write 12; }
        bind "Super Shift l" {
            Run "bash" "-c" "$HOME/.config/zellij/scripts/launcher.sh" {
                close_on_exit true
                floating true
            }
        }
        bind "Ctrl Shift a" {
            Run "bash" "-c" "$HOME/.config/zellij/scripts/agent-tracker" {
                close_on_exit true
                floating true
                name "agent-tracker"
            }
        }
    }
    pane {
        bind "r" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "H" { MovePane "Left"; }
        bind "J" { MovePane "Down"; }
        bind "K" { MovePane "Up"; }
        bind "L" { MovePane "Right"; }
    }
}

ui {
    pane_frames {
        rounded_corners true;
        hide_session_name true;
    }
}

// zellij-autolock: switch to Locked mode when the focused pane runs one of the
// trigger programs, so their keybinds (esp. Ctrl+h/j/k/l) pass through instead
// of being captured by Zellij. Unlocks automatically when focus leaves them.
plugins {
    autolock location="file:~/.config/zellij/plugins/zellij-autolock.wasm" {
        is_enabled true
        triggers "nvim|vim|fzf"
        reaction_seconds "0.3"
        print_to_log false
    }
}

load_plugins {
    autolock
}
