{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:zed.dev)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:catskull.net)",
      "WebFetch(domain:yazi-rs.github.io)",
      "WebFetch(domain:www.lazyvim.org)",
      "WebFetch(domain:lazyvim-ambitious-devs.phillips.codes)",
      "WebFetch(domain:notable-health.atlassian.net)",
      "WebFetch(domain:support.atlassian.com)",
      "WebFetch(domain:buildkite.com)",
      "mcp__atlassian__search",
      "mcp__atlassian__getConfluencePage",
      "mcp__atlassian__createConfluencePage",
      "mcp__atlassian__updateConfluencePage",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(git add:*)",
